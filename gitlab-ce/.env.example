# Domaines publics/résolus aussi depuis la VM Runner et les conteneurs de jobs.
GITLAB_HOSTNAME=gitlab.example.net
REGISTRY_HOSTNAME=registry.example.net
TZ=Europe/Paris

# À remplacer par les IP/CIDR réellement utilisés par Traefik et les proxies
# amont de confiance. Ne pas faire confiance à tous les réseaux RFC1918.
# Traefik local : relever le sous-réseau du réseau Docker traefik.
TRUSTED_PROXIES=

GITLAB_SSH_PORT=2222
SSH_BIND_IP=0.0.0.0
# Traefik local utilise directement les ports conteneur 80/5050.
# Traefik distant : remplacer HTTP_BIND_IP par l'IP privée de la VM GitLab.
HTTP_BIND_IP=127.0.0.1
GITLAB_HTTP_PORT=8081
REGISTRY_HTTP_PORT=5050

SMTP_HOST=smtp.example.net
SMTP_USER=
SMTP_PASSWORD=
SMTP_DOMAIN=example.net
GITLAB_EMAIL=gitlab@example.net

ISSUER=https://auth.example.net/application/o/gitlab/
CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URL=https://gitlab.example.net/users/auth/openid_connect/callback
