TZ=Europe/Paris

# URL publiques ; sans :8443 si le port public 443 est acheminé vers 8443.
# GitLab et Registry utilisent deux noms DNS distincts.
GITLAB_EXTERNAL_URL=https://gitlab.example.net
REGISTRY_EXTERNAL_URL=https://registry.example.net

# Chemins DANS le conteneur, sous le répertoire monté /etc/gitlab/ssl.
# Même paire possible pour les deux services si les SAN couvrent les deux noms.
GITLAB_TLS_CERTIFICATE=/etc/gitlab/ssl/gitlab.crt
GITLAB_TLS_KEY=/etc/gitlab/ssl/gitlab.key
REGISTRY_TLS_CERTIFICATE=/etc/gitlab/ssl/registry.crt
REGISTRY_TLS_KEY=/etc/gitlab/ssl/registry.key

# Interface privée de la VM ; 127.0.0.1 est un exemple non exposé au LAN.
HTTPS_BIND_IP=127.0.0.1
HTTPS_PORT=8443
GITLAB_SSH_PORT=2222
SSH_BIND_IP=0.0.0.0

# Répertoire hôte existant, renouvelé par step, lisible par deploy (UID 1001).
# Exemple fictif : ne pas stocker le chemin réel dans ce fichier versionné.
TLS_DIRECTORY=/chemin/local/des/certificats

SMTP_HOST=smtp.example.net
SMTP_USER=
SMTP_PASSWORD=
SMTP_DOMAIN=example.net
GITLAB_EMAIL=gitlab@example.net

ISSUER=https://auth.example.net/application/o/gitlab/
CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URL=https://gitlab.example.net/users/auth/openid_connect/callback
